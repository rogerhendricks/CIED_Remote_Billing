# ===================================================
# Cardiac Remote Monitoring & Billing Hub Configuration
# ===================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Clinic Branding
CLINIC_NAME="Westmead Hospital Cardiology Practice"

# Clinic Master Security Key (Shared with staff browser extensions & admin access)
# Generate a strong unique key for your clinic LAN (e.g. openssl rand -hex 16)
CLINIC_SECURITY_KEY="CARDIO-WESTMEAD-8820"

# Authorized Staff PINs (comma-separated 4-digit PINs for station lock/unlock)
# Note: In production, do NOT use default PINs like 1234.
CLINIC_STAFF_PINS="8820,9911,7742"

# Database Storage Directory (SQLite 3 with Write-Ahead Logging)
DATA_DIR="./data"

# Pre-seed demo patient records on startup (set to 'true' for dev/testing, 'false' for production)
SEED_DEMO_DATA=false
